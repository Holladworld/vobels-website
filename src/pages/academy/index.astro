---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

// Logic for the 2-day countdown (Client-side)
---

<Layout title="Vobels Academy | Skill Mastery">
  <div class="vobels-academy">
  <Container>
    <div class="vobels-academy__intro mt-20 text-center">
      <h1 class="text-4xl md:text-6xl font-black text-black tracking-tighter">Vobels Academy</h1>
      <p class="mt-4 text-zinc-500 max-w-2xl mx-auto">Choose your path: Build a professional registration agency or upskill in global industries.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 mt-16 mb-20">
      
      <div class="academy-card academy-card--featured relative group p-1 rounded-[2.5rem] overflow-hidden">
        <div class="academy-card__inner p-10 rounded-[2.4rem] h-full flex flex-col">
          <div class="flex justify-between items-start mb-6">
            <span class="academy-card__badge px-4 py-1 text-white text-[10px] font-bold rounded-full uppercase tracking-widest">Premium</span>
            <div id="countdown" class="text-red-600 font-bold text-xs animate-pulse"></div>
          </div>
          
          <h2 class="text-3xl font-bold text-black mb-4">Certified Registration Agent</h2>
          <p class="text-zinc-600 text-sm mb-6 flex-1">Become a professional intermediary. Master the legal portals of Nigeria.</p>
          
          <ul class="space-y-3 mb-8 text-sm text-zinc-700">
            <li class="flex items-center gap-2">✅ CAC Agent Account & Filings</li>
            <li class="flex items-center gap-2">✅ Trademark & NAFDAC Registration</li>
            <li class="flex items-center gap-2">✅ Tax (TIN) & Annual Returns</li>
            <li class="flex items-center gap-2">✅ Access to Private WhatsApp Group</li>
          </ul>

          <div class="mb-6">
            <span class="text-3xl font-black text-black">₦16,000</span>
            <span class="text-zinc-400 line-through ml-2">₦20,000</span>
            <p class="text-[10px] text-green-600 font-bold mt-1">20% DISCOUNT ACTIVE (New Student Bonus)</p>
          </div>

          <a href="/academy/become-an-agent" class="academy-card__primary block w-full text-center py-4 text-white rounded-2xl font-bold transition-all">Enroll as Agent</a>
        </div>
      </div>

      <div class="academy-card academy-card--upskill p-10 rounded-[2.5rem] flex flex-col">
        <span class="academy-card__eyebrow w-fit px-4 py-1 text-[10px] font-bold rounded-full uppercase tracking-widest mb-6">Upskill with Vobels</span>
        
        <h2 class="text-3xl font-bold text-black mb-4">Join Upskill with Vobels</h2>
        <p class="text-zinc-600 text-sm mb-6 flex-1">Access global courses in Software Engineering, Nursing, Marketing, and more for free. Only pay a commitment fee for follow-up and certification.</p>
        
        <div class="mb-8">
           <p class="text-sm font-bold text-black mb-2">Commitment Fee:</p>
           <span class="text-2xl font-black text-black">₦2,000</span>
        </div>

        <a href="https://forms.gle/zerbriU31G8PSBsj8" target="_blank" class="academy-card__secondary block w-full text-center py-4 rounded-2xl font-bold transition-all">Apply for Upskill</a>
      </div>

    </div>
  </Container>
  </div>

  <script is:inline>
    (function() {
        const GLOBAL_KEY = 'vobels_global_deadline';
        const countdownEl = document.getElementById('countdown');
        
        // Check if a deadline already exists in the browser
        let deadline = localStorage.getItem(GLOBAL_KEY);

        if (!deadline) {
        // First visit: Set deadline for 48 hours from now
        deadline = Date.now() + (48 * 60 * 60 * 1000);
        localStorage.setItem(GLOBAL_KEY, deadline);
        }

        function updateSyncTimer() {
        const now = Date.now();
        const remaining = deadline - now;

        if (!countdownEl) return;

        if (remaining <= 0) {
            countdownEl.innerHTML = "OFFER EXPIRED - PRICE UPDATING...";
            countdownEl.classList.replace('text-red-600', 'text-zinc-400');
            return;
        }

        const h = Math.floor(remaining / (1000 * 60 * 60));
        const m = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
        const s = Math.floor((remaining % (1000 * 60)) / 1000);

        // This text works for both the badge on Academy and the header on Agent page
        countdownEl.innerHTML = `DISCOUNT EXPIRES IN: ${h}h ${m}m ${s}s`;
        }

        // Run immediately and then every second
        setInterval(updateSyncTimer, 1000);
        updateSyncTimer();
    })();
    </script>

  <style>
    .vobels-academy { padding-bottom:clamp(56px,8vw,96px); }
    .vobels-academy__intro { max-width:760px; margin-left:auto; margin-right:auto; }
    .vobels-academy__intro h1 { color:#211b27; letter-spacing:-.065em; }
    .vobels-academy__intro p { color:#716a79; }
    .vobels-academy .academy-card { border:1px solid #e6deed; border-radius:2rem; box-shadow:0 18px 48px rgba(48,28,65,.055); }
    .vobels-academy .academy-card--featured { background:linear-gradient(145deg,#eee5f5,#f8f5fb 62%,#fff); border-color:#d9c8e8; }
    .vobels-academy .academy-card__inner { background:#fff; }
    .vobels-academy .academy-card--upskill { background:#f7f3fb; }
    .vobels-academy .academy-card__badge { background:#5D2A86; }
    .vobels-academy .academy-card__eyebrow { background:#eee5f5; color:#5D2A86; }
    .vobels-academy .academy-card h2 { color:#211b27; letter-spacing:-.045em; }
    .vobels-academy .academy-card p,.vobels-academy .academy-card li { color:#625b6b; }
    .vobels-academy .academy-card__primary { background:#5D2A86; }
    .vobels-academy .academy-card__primary:hover { background:#43205f; }
    .vobels-academy .academy-card__secondary { border:1px solid #5D2A86; background:#fff; color:#5D2A86; }
    .vobels-academy .academy-card__secondary:hover { background:#eee5f5; }
    @media(max-width:640px) {
      .vobels-academy .academy-card__inner,.vobels-academy .academy-card--upskill { padding:1.5rem; }
    }
  </style>

</Layout>