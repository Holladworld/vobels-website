---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";

const serviceCategories = [
  {
    id: "formation",
    title: "Business Formation & Structure",
    description: "Register your business properly with CAC, get licensed, and protect your intellectual property.",
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1200&h=850&fit=crop",
    imageAlt: "Business formation documents and planning workspace",
    features: ["CAC Registration (Business Name & LTD)", "NGO/Foundation Registration", "Trademark & Patent Filing", "NAFDAC & SCUML Certification", "Tax Clearance Certificate (TCC)"],
    ctaLink: "/service/formation",
    ctaText: "Start Your Registration"
  },
  {
    id: "identity",
    title: "Business Design & Identity",
    description: "Build a brand that stands out, communicates value, and attracts your ideal clients.",
    image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?w=1200&h=850&fit=crop",
    imageAlt: "Brand identity design materials",
    features: ["Brand Identity Package", "Logo Design & Guidelines", "Corporate Collateral Design", "Brand Positioning Strategy", "Visual Identity System"],
    ctaLink: "/service/identity",
    ctaText: "Build Your Brand"
  },
  {
    id: "operations",
    title: "Operations & Management",
    description: "Streamline your business with custom systems and automated workflows.",
    image: "https://images.unsplash.com/photo-1551434678-e076c2236a9a?w=1200&h=850&fit=crop",
    imageAlt: "Team collaborating on business operations",
    features: ["BizOS Setup", "Workflow Automation", "Financial Systems", "Operations Audit", "Process Optimization"],
    ctaLink: "/service/operations",
    ctaText: "Optimize Operations"
  },
  {
    id: "technology",
    title: "Digital Presence & Technology",
    description: "Get a professional website or custom web application built for your business.",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=1200&h=850&fit=crop",
    imageAlt: "Digital business analytics on a computer screen",
    features: ["Professional Website", "Custom Web Applications", "API Integration", "System Architecture Audit", "Business Software Solutions"],
    ctaLink: "/service/technology",
    ctaText: "Build Your Digital Presence"
  },
  {
    id: "expansion",
    title: "Growth & Expansion",
    description: "Scale your business with strategic marketing and market entry solutions.",
    image: "https://images.unsplash.com/photo-1552581234-26160f608093?w=1200&h=850&fit=crop",
    imageAlt: "Business growth strategy discussion",
    features: ["Content Strategy Setup", "Paid Ads Management", "Market Entry Strategy", "Lead Generation Systems", "Sales Funnel Optimization"],
    ctaLink: "/service/expansion",
    ctaText: "Scale Your Business"
  },
  {
    id: "global",
    title: "Global Business Access",
    description: "Expand internationally with DUNS numbers and foreign business registration.",
    image: "https://images.unsplash.com/photo-1526498460520-4c246339dccb?w=1200&h=850&fit=crop",
    imageAlt: "Global connectivity and international business",
    features: ["DUNS Number Registration", "US Business Registration", "UK Business Registration", "Global Compliance Advisory", "International Banking Guidance"],
    ctaLink: "/service/global",
    ctaText: "Go Global"
  },
  {
    id: "foreign",
    title: "Foreign Company Registration in Nigeria",
    description: "International companies entering Nigeria? We handle all local registration and compliance.",
    image: "https://images.unsplash.com/photo-1529243856184-fd5465488984?w=1200&h=850&fit=crop",
    imageAlt: "Lagos business district",
    features: ["CAC Foreign Company Registration", "Business Permit & Approvals", "Expatriate Quota & CERPAC", "Local Compliance & Tax", "Legal Advisory Support"],
    ctaLink: "/service/foreign-registration",
    ctaText: "Register in Nigeria",
    isNew: true
  }
];
---

<Layout title="Services | Vobels Limited" description="Explore Vobels business services and HostSuite website, hosting and digital operations support.">
  <main class="services-page">
    <section class="services-hero">
      <Container>
        <div class="services-hero__inner">
          <p class="eyebrow">HOW WE HELP</p>
          <h1>Build the business.<br /><span>Run it with confidence.</span></h1>
          <p class="services-hero__copy">From setting up and structuring your business to keeping its digital presence running, find the support you need at every stage.</p>
          <div class="services-hero__actions">
            <a class="button button--primary" href="#business">Explore business services <span aria-hidden="true">↘</span></a>
            <a class="text-link" href="#hostsuite">Discover HostSuite <span aria-hidden="true">→</span></a>
          </div>
          <div class="services-hero__index"><span>01 / BUSINESS SERVICES</span><span>02 / DIGITAL OPERATIONS</span></div>
        </div>
      </Container>
    </section>

    <section id="business" class="business-section">
      <Container>
        <div class="section-heading">
          <div><p class="eyebrow">01 — BUSINESS SERVICES</p><h2>Make your next<br /><span>business move count.</span></h2></div>
          <p>Practical support for the work behind a stronger business — from registration and identity to operations, technology and expansion.</p>
        </div>
        <div class="service-list">
          {serviceCategories.map((service, index) => (
            <article id={service.id} class:list={["service-row", index % 2 === 1 && "service-row--reverse"]}>
              <a class="service-row__image" href={service.ctaLink} aria-label={service.title}>
                <img src={service.image} alt={service.imageAlt} loading="lazy" />
                <span class="service-row__number">{String(index + 1).padStart(2, "0")}</span>
              </a>
              <div class="service-row__content">
                {service.isNew && <span class="service-tag">New service</span>}
                <p class="service-kicker">BUSINESS SUPPORT / {String(index + 1).padStart(2, "0")}</p>
                <h3>{service.title}</h3>
                <p class="service-description">{service.description}</p>
                <ul>{service.features.map((feature) => <li><span aria-hidden="true">↗</span>{feature}</li>)}</ul>
                <a class="service-cta" href={service.ctaLink}>{service.ctaText}<span aria-hidden="true">→</span></a>
              </div>
            </article>
          ))}
        </div>
      </Container>
    </section>

    <section id="hostsuite" class="hostsuite-section">
      <div class="hostsuite-section__image" role="img" aria-label="Modern digital workspace with screens and technology"></div>
      <div class="hostsuite-section__shade"></div>
      <Container>
        <div class="hostsuite-section__content">
          <p class="eyebrow eyebrow--light">02 — DIGITAL OPERATIONS / A VOBELS PRODUCT</p>
          <p class="hostsuite-wordmark">HOST<span>SUITE</span></p>
          <h2>Your website is part<br />of your business. <em>Manage it that way.</em></h2>
          <p class="hostsuite-section__copy">Websites, hosting, domains and business email can become difficult to manage — especially when the person who built them is no longer available. HostSuite helps bring those moving parts into one place, with support when you need it.</p>
          <div class="hostsuite-points">
            <span>Website & hosting</span><span>Domains & email</span><span>Diagnosis & support</span><span>Ongoing management</span>
          </div>
          <div class="hostsuite-actions">
            <a class="button button--light" href="https://hostsuite.vobels.com.ng">Explore HostSuite <span aria-hidden="true">↗</span></a>
            <a class="hostsuite-diagnostic" href="https://hostsuite.vobels.com.ng/#diagnostic">Start with a website diagnostic <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </Container>
    </section>

    <section class="services-close">
      <Container>
        <div class="services-close__inner">
          <div><p class="eyebrow">LET'S FIND THE RIGHT STARTING POINT</p><h2>Not sure what your business needs next?</h2><p>Tell us where you are and what you are trying to achieve. We’ll help you identify a practical next step.</p></div>
          <a class="button button--primary" href="/contact">Talk to Vobels <span aria-hidden="true">→</span></a>
        </div>
      </Container>
    </section>
  </main>
</Layout>

<style>
  .services-page { color:#211b27; background:#fff; }
  .services-page .eyebrow { margin:0 0 18px; color:#5D2A86; font-size:10px; font-weight:800; letter-spacing:.19em; }
  .services-hero { padding:92px 0 38px; background:linear-gradient(115deg,#f7f4f9 0%,#fff 62%); }
  .services-hero__inner { max-width:1040px; margin:auto; }
  .services-hero h1 { max-width:900px; margin:0; font-size:clamp(48px,8vw,96px); line-height:.98; letter-spacing:-.075em; font-weight:800; }
  .services-hero h1 span,.section-heading h2 span { color:#76509a; }
  .services-hero__copy { max-width:610px; margin:27px 0 0; color:#625b68; font-size:17px; line-height:1.8; }
  .services-hero__actions { display:flex; align-items:center; flex-wrap:wrap; gap:28px; margin-top:30px; }
  .button { display:inline-flex; align-items:center; justify-content:center; gap:20px; min-height:50px; padding:0 21px; font-size:12px; font-weight:700; text-decoration:none; transition:transform .2s,background .2s; }
  .button:hover { transform:translateY(-2px); }
  .button--primary { color:#fff; background:#5D2A86; }
  .button--primary:hover { background:#452064; }
  .text-link { color:#302638; font-size:12px; font-weight:700; text-decoration:none; }
  .services-hero__index { display:flex; gap:34px; flex-wrap:wrap; padding-top:70px; color:#8a8290; font-size:9px; font-weight:700; letter-spacing:.15em; }
  .business-section { padding:100px 0 110px; }
  .section-heading { display:grid; grid-template-columns:1.2fr .8fr; align-items:end; gap:50px; margin-bottom:58px; }
  .section-heading h2 { margin:0; font-size:clamp(38px,5.5vw,65px); line-height:1.02; letter-spacing:-.065em; font-weight:800; }
  .section-heading > p { max-width:430px; margin:0 0 5px; color:#716a79; font-size:15px; line-height:1.8; }
  .service-list { border-top:1px solid #e9e4ed; }
  .service-row { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:clamp(34px,7vw,100px); padding:54px 0; border-bottom:1px solid #e9e4ed; }
  .service-row--reverse .service-row__image { order:2; }
  .service-row--reverse .service-row__content { order:1; }
  .service-row__image { position:relative; display:block; min-height:300px; overflow:hidden; background:#eee9f2; }
  .service-row__image img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .6s; }
  .service-row__image:hover img { transform:scale(1.04); }
  .service-row__number { position:absolute; left:18px; bottom:18px; padding:10px 13px; color:#fff; background:#5D2A86; font-size:11px; font-weight:800; }
  .service-kicker { margin:0 0 14px; color:#8b8192; font-size:9px; font-weight:800; letter-spacing:.16em; }
  .service-row h3 { margin:0; color:#211b27; font-size:clamp(27px,3vw,39px); line-height:1.08; letter-spacing:-.045em; font-weight:800; }
  .service-description { max-width:480px; margin:17px 0 22px; color:#716a79; font-size:14px; line-height:1.8; }
  .service-row ul { display:grid; grid-template-columns:1fr 1fr; gap:11px 18px; margin:0 0 27px; padding:0; list-style:none; }
  .service-row li { display:flex; gap:8px; color:#514b59; font-size:11px; line-height:1.5; }
  .service-row li span { color:#5D2A86; font-weight:800; }
  .service-cta { display:inline-flex; align-items:center; gap:22px; padding-bottom:7px; border-bottom:1px solid #5D2A86; color:#5D2A86; font-size:12px; font-weight:800; text-decoration:none; }
  .service-tag { display:inline-block; margin-bottom:13px; padding:6px 9px; color:#5D2A86; background:#f1eaf6; font-size:9px; font-weight:800; text-transform:uppercase; letter-spacing:.1em; }
  .hostsuite-section { position:relative; isolation:isolate; overflow:hidden; padding:105px 0 110px; color:#fff; background:#17121c; }
  .hostsuite-section__image,.hostsuite-section__shade { position:absolute; inset:0; z-index:-1; }
  .hostsuite-section__image { background-image:url("https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=2000&h=1300&fit=crop"); background-size:cover; background-position:center; opacity:.58; }
  .hostsuite-section__shade { background:linear-gradient(90deg,rgba(18,13,23,.96) 0%,rgba(24,17,31,.88) 52%,rgba(24,17,31,.48) 100%); }
  .hostsuite-section__content { max-width:780px; }
  .eyebrow--light { color:#d6bce9 !important; }
  .hostsuite-wordmark { margin:0 0 24px; color:#fff; font-size:13px; font-weight:900; letter-spacing:.18em; }
  .hostsuite-wordmark span { color:#c6a5df; }
  .hostsuite-section h2 { margin:0; font-size:clamp(39px,6vw,70px); line-height:1.02; letter-spacing:-.065em; font-weight:800; }
  .hostsuite-section h2 em { color:#d4b6e8; font-style:normal; }
  .hostsuite-section__copy { max-width:640px; margin:23px 0 0; color:#e2dce7; font-size:15px; line-height:1.85; }
  .hostsuite-points { display:flex; flex-wrap:wrap; gap:10px 24px; margin-top:28px; color:#f0eaf4; font-size:11px; }
  .hostsuite-points span:before { content:"↗"; margin-right:8px; color:#c6a5df; }
  .hostsuite-actions { display:flex; flex-wrap:wrap; align-items:center; gap:24px; margin-top:34px; }
  .button--light { color:#24192c; background:#fff; }
  .button--light:hover { background:#eee5f4; }
  .hostsuite-diagnostic { color:#fff; font-size:12px; font-weight:700; text-decoration:none; }
  .services-close { padding:75px 0; background:#f7f4f9; }
  .services-close__inner { display:flex; align-items:center; justify-content:space-between; gap:35px; }
  .services-close h2 { max-width:620px; margin:0; font-size:clamp(29px,4vw,43px); line-height:1.08; letter-spacing:-.05em; }
  .services-close p:not(.eyebrow) { max-width:570px; margin:14px 0 0; color:#716a79; font-size:13px; line-height:1.8; }
  @media(max-width:760px) {
    .services-hero { padding:65px 0 30px; }
    .services-hero__copy { font-size:15px; }
    .services-hero__index { padding-top:48px; gap:13px 22px; }
    .business-section { padding:68px 0 75px; }
    .section-heading { grid-template-columns:1fr; gap:18px; margin-bottom:32px; }
    .service-row { grid-template-columns:1fr; gap:25px; padding:34px 0; }
    .service-row--reverse .service-row__image,.service-row--reverse .service-row__content { order:initial; }
    .service-row__image { min-height:240px; }
    .service-row ul { gap:10px 12px; }
    .hostsuite-section { padding:75px 0; }
    .hostsuite-section__shade { background:rgba(18,13,23,.82); }
    .hostsuite-actions { align-items:flex-start; flex-direction:column; gap:19px; }
    .services-close { padding:58px 0; }
    .services-close__inner { align-items:flex-start; flex-direction:column; }
  }
</style>
