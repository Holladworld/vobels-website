---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import { posts, initializePosts } from "@/lib/posts-store";

const { slug } = Astro.params;

await initializePosts();

// Decode the slug to handle any URL encoding
const decodedSlug = decodeURIComponent(slug);
const post = posts.find(p => p.slug === decodedSlug);

if (!post) {
  return new Response("Post not found", { status: 404 });
}
---

<Layout 
  title={post.title} 
  description={post.snippet?.replace(/<[^>]*>/g, '') || post.title} 
  image={post.coverImage}
>
  <Container>
    <div class="vobels-blog-article mx-auto max-w-3xl">

      <header class="vobels-blog-article__header">
        <span class="vobels-blog-article__category">
          {post.category}
        </span>

        <h1>
          {post.title}
        </h1>

        <div class="vobels-blog-article__meta">
          {post.author} / {new Date(post.publishDate).toDateString()}
        </div>
      </header>

      {post.coverImage && post.coverImage !== '/default-cover.jpg' && (
        <img 
          src={post.coverImage} 
          alt={post.title}
          class="vobels-blog-article__cover" 
          loading="lazy"
        />
      )}

      <!-- FIX: Proper content rendering -->
      <article class="vobels-blog-article__content prose prose-lg max-w-none mx-auto">
        {post.source === 'content' ? (
          // For markdown content, we need to parse it
          <Fragment set:html={post.content} />
        ) : (
          // For API content, it's already HTML or markdown
          <Fragment set:html={post.content} />
        )}
      </article>

      <div class="vobels-blog-article__back">
        <a href="/blog">
          ← Back to all posts
        </a>
      </div>

    </div>
  </Container>
</Layout>

<style is:global>
  .vobels-blog-article { padding:clamp(42px,7vw,82px) 0 96px; }
  .vobels-blog-article__header { margin-bottom:38px; text-align:left; }
  .vobels-blog-article__category { display:inline-block; color:#5D2A86; font:700 10px/1.4 var(--font-sans); letter-spacing:.2em; text-transform:uppercase; }
  .vobels-blog-article__header h1 { margin:20px 0 0; color:#211b27; font:600 clamp(2.6rem,5.7vw,4.8rem)/1.02 var(--font-display); letter-spacing:-.075em; }
  .vobels-blog-article__meta { margin-top:18px; color:#8a8291; font:600 11px/1.5 var(--font-sans); letter-spacing:.04em; }
  .vobels-blog-article__cover { display:block; width:100%; max-height:560px; margin:0 0 42px; object-fit:cover; }
  .vobels-blog-article__content { color:#4f4857; font-family:var(--font-sans); font-size:16px; line-height:1.85; }
  .vobels-blog-article__content h1,.vobels-blog-article__content h2,.vobels-blog-article__content h3,.vobels-blog-article__content h4 { color:#211b27; font-family:var(--font-display); font-weight:600; letter-spacing:-.055em; line-height:1.15; }
  .vobels-blog-article__content h1 { margin:2.2em 0 .65em; font-size:clamp(2rem,4vw,3rem); }
  .vobels-blog-article__content h2 { margin:2em 0 .65em; font-size:clamp(1.7rem,3.5vw,2.35rem); }
  .vobels-blog-article__content h3 { margin:1.8em 0 .6em; font-size:clamp(1.35rem,2.7vw,1.75rem); }
  .vobels-blog-article__content p { margin:0 0 1.35em; color:#625b6b; font-size:16px; line-height:1.85; }
  .vobels-blog-article__content ul,.vobels-blog-article__content ol { margin:.6em 0 1.4em; padding-left:1.5em; }
  .vobels-blog-article__content li { margin:.35em 0; color:#625b6b; font-size:15px; line-height:1.8; }
  .vobels-blog-article__content strong { color:#211b27; font-weight:700; }
  .vobels-blog-article__content a { color:#5D2A86; text-decoration:underline; text-underline-offset:3px; }
  .vobels-blog-article__content blockquote { margin:2em 0; padding:8px 0 8px 22px; border-left:3px solid #5D2A86; color:#51445d; }
  .vobels-blog-article__content img { max-width:100%; height:auto; margin:2em auto; }
  .vobels-blog-article__back { margin-top:48px; padding-top:24px; border-top:1px solid #e6deed; }
  .vobels-blog-article__back a { color:#5D2A86; font:700 12px/1.5 var(--font-sans); text-decoration:none; }
  @media(max-width:640px) { .vobels-blog-article__header h1 { font-size:clamp(2.45rem,11vw,3.5rem); } .vobels-blog-article__content p { font-size:15px; } }
</style>
