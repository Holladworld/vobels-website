---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import BusinessCalculator from "@/components/BusinessCalculator.astro";
---

<Layout title="Business Cost Calculator | Vobels" description="Estimate costs for business registration, intellectual property, compliance and international business services with Vobels.">
  <div class="vobels-calculator-page">
    <Container>
      <section class="vobels-calculator-hero" aria-labelledby="calculator-title">
        <div class="vobels-calculator-hero__copy">
          <p class="vobels-eyebrow"><span></span> Plan with clarity</p>
          <h1 id="calculator-title">Understand the cost.<br /><em>Plan your next move.</em></h1>
          <p class="vobels-calculator-hero__lead">Choose the service you need, tell us a little about it, and get an estimated cost breakdown before you decide how to proceed.</p>
          <div class="vobels-calculator-hero__trust"><span>Clear fee breakdown</span><span>Multiple service categories</span><span>No obligation to proceed</span></div>
        </div>
        <aside class="vobels-calculator-guide" aria-label="How to use the calculator">
          <span class="vobels-calculator-guide__label">HOW IT WORKS</span>
          <ol>
            <li><b>01</b><span><strong>Select a service</strong><small>Choose the area you want to estimate.</small></span></li>
            <li><b>02</b><span><strong>Set your options</strong><small>Pick the business type or service package.</small></span></li>
            <li><b>03</b><span><strong>Review your estimate</strong><small>See official fees and Vobels service fees.</small></span></li>
          </ol>
        </aside>
      </section>
      <BusinessCalculator />
      <div class="vobels-calculator-help">
        <div><strong>Need a hand choosing?</strong><p>Tell us what you are trying to achieve. Our team can help you understand the right service before you proceed.</p></div>
        <a href="/contact">Talk to our team <span aria-hidden="true">→</span></a>
      </div>
    </Container>
  </div>
</Layout>

<style>
  .vobels-calculator-page { padding: clamp(38px,6vw,76px) 0 clamp(64px,8vw,104px); }
  .vobels-calculator-hero { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr); gap:clamp(30px,6vw,80px); align-items:end; padding:0 0 clamp(42px,6vw,72px); }
  .vobels-calculator-hero h1 { margin:22px 0 0; color:#211d20; font:600 clamp(2.8rem,6vw,5.5rem)/.99 var(--font-display); letter-spacing:-.075em; }
  .vobels-calculator-hero h1 em { color:#5D2A86; font-style:normal; }
  .vobels-calculator-hero__lead { max-width:650px; margin:24px 0 0; color:#716b68; font-size:clamp(15px,1.5vw,18px); line-height:1.8; }
  .vobels-calculator-hero__trust { display:flex; flex-wrap:wrap; gap:10px 22px; margin-top:28px; color:#5b5552; font-size:11px; font-weight:700; }
  .vobels-calculator-hero__trust span::before { content:"✓"; margin-right:8px; color:#5D2A86; }
  .vobels-calculator-guide { padding:24px 26px; border:1px solid #d8d0c5; background:#eee8df; }
  .vobels-calculator-guide__label { color:#5D2A86; font-size:9px; font-weight:700; letter-spacing:.17em; }
  .vobels-calculator-guide ol { display:grid; gap:20px; margin:20px 0 0; padding:0; list-style:none; }
  .vobels-calculator-guide li { display:grid; grid-template-columns:30px 1fr; gap:12px; align-items:start; }
  .vobels-calculator-guide li > b { color:#5D2A86; font:700 11px/1.5 var(--font-sans); }
  .vobels-calculator-guide li span { display:grid; gap:3px; }
  .vobels-calculator-guide strong { color:#211d20; font-size:12px; }
  .vobels-calculator-guide small { color:#716b68; font-size:11px; line-height:1.5; }
  .vobels-calculator-help { display:flex; justify-content:space-between; align-items:center; gap:24px; margin-top:28px; padding:22px 26px; border-left:3px solid #5D2A86; background:#eee8df; }
  .vobels-calculator-help strong { color:#211d20; font-size:14px; }
  .vobels-calculator-help p { max-width:650px; margin:5px 0 0; color:#716b68; font-size:12px; }
  .vobels-calculator-help a { display:inline-flex; align-items:center; gap:12px; flex-shrink:0; padding:13px 18px; background:#5D2A86; color:#fff; font-size:11px; font-weight:700; text-decoration:none; }
  .vobels-calculator-help a:hover { background:#43205f; }
  @media(max-width:760px) { .vobels-calculator-hero { grid-template-columns:1fr; gap:28px; } .vobels-calculator-hero__trust { gap:10px 16px; } .vobels-calculator-help { align-items:stretch; flex-direction:column; } .vobels-calculator-help a { justify-content:center; } }
</style>