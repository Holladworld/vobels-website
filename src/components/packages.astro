---
const packages = [
  {
    name: "Startup Launch",
    description: "For new businesses needing a rock-solid foundation.",
    features: [
      "Business Structure & CAC",
      "Brand Identity & Guidelines",
      "Professional Website",
      "Compliance Setup",
    ],
    button: "Start Building",
    buttonLink: "/contact",
    featured: false,
  },
  {
    name: "Growth Accelerator",
    description: "For existing businesses ready to professionalize and scale.",
    features: [
      "Brand Repositioning",
      "Marketing & Ads Strategy",
      "Financial Systems",
      "Operational Process Review",
    ],
    button: "Scale Now",
    buttonLink: "/contact",
    featured: true,
  },
  {
    name: "DUNS Number & Global Access",
    description: "For Nigerian businesses expanding to global markets.",
    features: [
      "DUNS Number Registration ($40)",
      "US Business Registration",
      "UK Business Registration",
      "Global Compliance Advisory",
    ],
    button: "Go Global",
    buttonLink: "/service/global",
    featured: false,
    type: "global",
  },
  {
    name: "Foreign Company Registration in Nigeria",
    description: "For international companies entering the Nigerian market.",
    features: [
      "CAC Foreign Company Registration",
      "Business Permit & Approvals",
      "Expatriate Quota & CERPAC Support",
      "Local Compliance & Tax Registration",
    ],
    button: "Register in Nigeria",
    buttonLink: "/service/foreign-registration",
    featured: false,
    type: "foreign",
    isNew: true,
  },
  {
    name: "Enterprise Support",
    description: "Serious management for established companies.",
    features: [
      "Ongoing Strategy Advisory",
      "Financial & Compliance Monitoring",
      "Dedicated Support Team",
      "Expansion Roadmap",
    ],
    button: "Contact Executive Team",
    buttonLink: "/contact",
    featured: false,
  },
  {
    name: "Agent Academy",
    description: "Learn to register CAC, NAFDAC, and Trademarks professionally.",
    features: [
      "Name Search Mastery",
      "Agent Account Setup",
      "Step-by-Step Portals",
      "Private WhatsApp Group",
    ],
    button: "Become an Agent",
    buttonLink: "/academy/become-an-agent",
    featured: false,
  },
];
---

<section class="vobels-packages" id="packages" aria-labelledby="packages-heading">
  <div class="vobels-packages__heading">
    <div>
      <p class="vobels-eyebrow"><span></span> Ways to work with us</p>
      <h2 id="packages-heading">The right support<br /><em>for your next stage.</em></h2>
    </div>
    <p>Structured solutions for businesses at different points in their journey. Choose a starting point and we can take the conversation from there.</p>
  </div>

  <div class="vobels-packages__list">
    {packages.map((item, index) => (
      <article class:list={["vobels-package", item.featured && "vobels-package--featured"]}>
        <div class="vobels-package__name">
          <span class="vobels-package__index">{String(index + 1).padStart(2, "0")}</span>
          <div>
            {item.isNew && <span class="vobels-package__tag">New service</span>}
            {item.type === "global" && <span class="vobels-package__tag">Global access</span>}
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
        </div>
        <ul class="vobels-package__features">
          {item.features.map((feature) => <li><span aria-hidden="true">+</span>{feature}</li>)}
        </ul>
        <a href={item.buttonLink} class="vobels-package__link">{item.button}<span aria-hidden="true">↗</span></a>
      </article>
    ))}
  </div>

  <div class="vobels-packages__regional">
    <div>
      <span>01 / OUTBOUND</span>
      <h3>Nigerian business going global?</h3>
      <p>Get your DUNS Number &amp; register abroad.</p>
      <a href="/service/global">Explore Global Access <span aria-hidden="true">↗</span></a>
    </div>
    <div>
      <span>02 / INBOUND</span>
      <h3>International agency entering Nigeria?</h3>
      <p>We handle your company registration locally.</p>
      <a href="/service/foreign-registration">Register in Nigeria <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>