---
const slides = [
  {
    kicker: "01 / START WITH CLARITY",
    title: "A stronger foundation for what comes next.",
    description: "From business formation and structure to a clear direction for growth."
  },
  {
    kicker: "02 / BUILD WHAT MATTERS",
    title: "The right identity, systems and tools.",
    description: "Bring your brand, operations and digital presence together."
  },
  {
    kicker: "03 / MANAGE WITH INTENTION",
    title: "Make the day-to-day work better.",
    description: "Practical support to help your business run with greater confidence."
  },
  {
    kicker: "04 / GROW WITH PURPOSE",
    title: "Turn progress into lasting momentum.",
    description: "Prepare for new opportunities, stronger markets and the next stage."
  }
];
---

<section class="vobels-banner" aria-label="The Vobels business journey">
  <div class="vobels-banner__top">
    <span>THE VOBELS APPROACH</span>
    <span>BUILD / MANAGE / SCALE</span>
  </div>
  <div class="vobels-banner__slides" id="vobels-banner-slides">
    {slides.map((slide, index) => (
      <article class:list={["vobels-banner__slide", index === 0 && "is-active"]} aria-hidden={index === 0 ? "false" : "true"}>
        <div class="vobels-banner__copy">
          <span class="vobels-banner__kicker">{slide.kicker}</span>
          <h2>{slide.title}</h2>
          <p>{slide.description}</p>
        </div>
        <span class="vobels-banner__index">{String(index + 1).padStart(2, "0")} <i>/ 04</i></span>
      </article>
    ))}
  </div>
  <div class="vobels-banner__controls">
    <div class="vobels-banner__progress" aria-hidden="true"><span id="vobels-banner-progress"></span></div>
    <div class="vobels-banner__navigation">
      <button type="button" id="vobels-banner-prev" aria-label="Previous banner message">←</button>
      <button type="button" id="vobels-banner-next" aria-label="Next banner message">→</button>
    </div>
  </div>
</section>

<style>
  .vobels-banner { margin: 0 0 clamp(70px,9vw,116px); padding: 22px clamp(22px,4vw,48px) 20px; background: #21191f; color: #f4f0e9; }
  .vobels-banner__top { display:flex; justify-content:space-between; gap:14px; color:rgba(244,240,233,.48); font:700 9px/1.4 var(--font-sans); letter-spacing:.16em; }
  .vobels-banner__slides { position:relative; min-height:176px; }
  .vobels-banner__slide { position:absolute; inset:0; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:24px; align-items:center; opacity:0; visibility:hidden; transform:translateY(8px); transition:opacity .45s ease, transform .45s ease, visibility .45s; }
  .vobels-banner__slide.is-active { position:relative; opacity:1; visibility:visible; transform:translateY(0); }
  .vobels-banner__kicker { color:#b99acb; font:700 9px/1.4 var(--font-sans); letter-spacing:.16em; }
  .vobels-banner__slide h2 { max-width:760px; margin:10px 0 0; color:#f4f0e9; font:600 clamp(1.8rem,4vw,3.5rem)/1.03 var(--font-display); letter-spacing:-.065em; }
  .vobels-banner__slide p { margin:10px 0 0; color:rgba(244,240,233,.62); font-size:12px; }
  .vobels-banner__index { align-self:end; padding-bottom:10px; color:#b99acb; font:600 12px/1 var(--font-sans); }
  .vobels-banner__index i { color:rgba(244,240,233,.38); font-style:normal; }
  .vobels-banner__controls { display:flex; align-items:center; justify-content:space-between; gap:20px; padding-top:12px; border-top:1px solid rgba(244,240,233,.16); }
  .vobels-banner__progress { width:100%; height:2px; overflow:hidden; background:rgba(244,240,233,.16); }
  .vobels-banner__progress span { display:block; width:0; height:100%; background:#b99acb; transition:width .12s linear; }
  .vobels-banner__navigation { display:flex; gap:7px; }
  .vobels-banner__navigation button { display:flex; width:32px; min-width:32px; min-height:32px; height:32px; align-items:center; justify-content:center; border:1px solid rgba(244,240,233,.3); background:transparent; color:#f4f0e9; cursor:pointer; }
  .vobels-banner__navigation button:hover { border-color:#b99acb; color:#b99acb; }
  @media(max-width:640px) {
    .vobels-banner { margin-left:-20px; margin-right:-20px; padding:20px; }
    .vobels-banner__slides { min-height:210px; }
    .vobels-banner__slide { grid-template-columns:1fr; gap:8px; align-content:center; }
    .vobels-banner__index { display:none; }
    .vobels-banner__slide h2 { font-size:clamp(1.8rem,8vw,2.5rem); }
    .vobels-banner__top { font-size:8px; }
  }
  @media(prefers-reduced-motion:reduce) {
    .vobels-banner__slide { transition:none; transform:none; }
  }
</style>

<script>
  const root = document.querySelector(".vobels-banner");
  if (root && !root.hasAttribute("data-initialized")) {
    root.setAttribute("data-initialized", "true");
    const slides = Array.from(root.querySelectorAll(".vobels-banner__slide"));
    const progress = root.querySelector("#vobels-banner-progress");
    const previous = root.querySelector("#vobels-banner-prev");
    const next = root.querySelector("#vobels-banner-next");
    const duration = 6500;
    let active = 0;
    let started = Date.now();
    let timer;

    const show = (index) => {
      active = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const selected = i === active;
        slide.classList.toggle("is-active", selected);
        slide.setAttribute("aria-hidden", selected ? "false" : "true");
      });
      started = Date.now();
      if (progress) progress.style.width = "0%";
    };
    const tick = () => {
      const elapsed = Date.now() - started;
      if (progress) progress.style.width = `${Math.min(100, (elapsed / duration) * 100)}%`;
      if (elapsed >= duration) show(active + 1);
    };
    previous?.addEventListener("click", () => show(active - 1));
    next?.addEventListener("click", () => show(active + 1));
    timer = window.setInterval(tick, 100);
    root.addEventListener("mouseenter", () => window.clearInterval(timer));
    root.addEventListener("mouseleave", () => { started = Date.now(); timer = window.setInterval(tick, 100); });
  }
</script>