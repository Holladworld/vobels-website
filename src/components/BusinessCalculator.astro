---
// Complete Business Services Cost Calculator - All services included
---

<div class="vobels-calculator" id="calculator-container">
  <div class="vobels-calculator__heading">
    <div><span class="vobels-calculator__step">YOUR ESTIMATE / 01</span><h2>What would you like to calculate?</h2><p>Choose every service you need. Your combined estimate updates as you configure each selection.</p></div>
    <span class="vobels-calculator__estimate-mark">₦ / $</span>
  </div>

  <div class="space-y-5">
    <!-- Service Category Selection -->
    <div>
      <label class="vobels-calculator__field-label">01 — Choose all the service categories you need</label>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
        <button type="button" data-category="registration" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all bg-black text-white border-black text-sm">Registration<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="trademark" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">Trademark<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="copyright" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">Copyright<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="patent" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">Patent<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="nafdac" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">NAFDAC<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="global" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">Global Access<span class="cat-btn__state" aria-hidden="true"></span></button>
        <button type="button" data-category="foreign" class="cat-btn py-2 px-3 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black text-sm">Foreign Reg<span class="cat-btn__state" aria-hidden="true"></span></button>
      </div>
      <p id="category-description" class="vobels-calculator__hint">Select multiple categories to build one combined estimate.</p>
    </div>

    <div id="results" class="vobels-calculator__results">
      <div class="vobels-calculator__results-head"><span>LIVE ESTIMATE</span><h3>Your selected services</h3><p id="price-note">Choose one or more categories to build a combined estimate.</p></div>
      <div id="estimate-items" class="vobels-calculator__estimate-items"><p class="vobels-calculator__empty">Your selected services and prices will appear here.</p></div>
      <div id="estimate-totals" class="vobels-calculator__estimate-totals"></div>
      <div id="lead-capture" class="mt-5 pt-4 border-t border-zinc-200">
        <p class="text-sm font-medium text-black mb-2">Want help with this estimate?</p><p class="text-xs text-zinc-500 mb-3">Leave your email and our team can follow up with the selected services and next steps.</p>
        <div class="flex gap-2"><input type="email" id="lead-email" placeholder="Your email address" class="flex-1 px-3 py-2 border border-zinc-200 rounded-lg text-sm"><button id="submit-lead" class="px-4 py-2 bg-black text-white rounded-lg text-sm font-medium hover:bg-zinc-800">Send</button></div>
        <p class="text-[10px] text-zinc-400 mt-2">No spam. Unsubscribe anytime.</p>
      </div>
    </div>

    <!-- REGISTRATION SECTION -->
    <div id="registration-section" class="space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Business Type</label>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" data-type="ltd" class="type-btn py-3 px-4 rounded-xl border-2 font-medium transition-all bg-black text-white border-black">Private Limited (LTD)</button>
          <button type="button" data-type="business-name" class="type-btn py-3 px-4 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black">Business Name</button>
          <button type="button" data-type="ngo" class="type-btn py-3 px-4 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black">NGO / Foundation</button>
          <button type="button" data-type="plc" class="type-btn py-3 px-4 rounded-xl border-2 font-medium transition-all border-zinc-200 hover:border-black">Public Limited (PLC)</button>
        </div>
      </div>

      <div id="share-capital-group" class="hidden">
        <label class="block text-sm font-bold text-black mb-2">Share Capital (₦)</label>
        <div class="flex gap-3">
          <input type="number" id="share-capital" value="1000000" class="flex-1 px-4 py-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black">
          <button id="calculate-btn" class="px-6 py-3 bg-black text-white rounded-xl font-medium hover:bg-zinc-800 transition-all">Calculate</button>
        </div>
        <p class="text-xs text-zinc-400 mt-2">Minimum ₦1,000,000. Additional ₦25,000 per extra million</p>
      </div>

      <div id="taxpromax-group" class="hidden">
        <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
          <input type="checkbox" id="include-taxpromax" class="w-4 h-4">
          <div>
            <span class="font-medium">Include TaxPromax Activation</span>
            <p class="text-xs text-zinc-500">+₦25,000 - Get TIN Certificate + NRS TIN onboarding</p>
          </div>
        </label>
      </div>
    </div>

    <!-- TRADEMARK SECTION -->
    <div id="trademark-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Trademark Option</label>
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="trademark-option" value="basic" class="w-4 h-4" checked>
            <div>
              <span class="font-medium">Trademark Registration</span>
              <p class="text-xs text-zinc-500">₦70,000 - Search Report, Application, Acceptance Letter</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="trademark-option" value="premium" class="w-4 h-4">
            <div>
              <span class="font-medium">Trademark Registration + Certificate</span>
              <p class="text-xs text-zinc-500">₦150,000 - Includes Certificate of Trademark</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- COPYRIGHT SECTION -->
    <div id="copyright-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Copyright Option</label>
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="copyright-option" value="basic" class="w-4 h-4" checked>
            <div>
              <span class="font-medium">Copyright Protection</span>
              <p class="text-xs text-zinc-500">₦50,000 - One paper base, Search Report, Grant Notification</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="copyright-option" value="premium" class="w-4 h-4">
            <div>
              <span class="font-medium">Copyright Protection (Premium)</span>
              <p class="text-xs text-zinc-500">₦150,000 - Includes Certified True Copy of Certificate</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- PATENT SECTION -->
    <div id="patent-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Patent Registration</label>
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="patent-option" value="local" class="w-4 h-4" checked>
            <div>
              <span class="font-medium">Local Patent Registration</span>
              <p class="text-xs text-zinc-500">₦250,000 - Nigeria only, one invention/claim</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="patent-option" value="international" class="w-4 h-4">
            <div>
              <span class="font-medium">International Patent (PCT)</span>
              <p class="text-xs text-zinc-500">$2,000 USD - International protection, PCT filing</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- NAFDAC SECTION -->
    <div id="nafdac-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">NAFDAC Product Category</label>
        <select id="nafdac-category" class="w-full p-3 border border-zinc-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-black">
          <option value="micro">Micro-Scale Food - ₦95,000</option>
          <option value="small">Small Scale Food - ₦150,000</option>
          <option value="large">Large Scale Food - ₦250,000</option>
          <option value="drugs">Drugs & Pharmaceuticals - ₦300,000</option>
          <option value="cosmetics-small">Cosmetics Small Scale - ₦120,000</option>
          <option value="cosmetics-large">Cosmetics Large Scale - ₦200,000</option>
        </select>
      </div>
    </div>

    <!-- GLOBAL ACCESS SECTION (DUNS, US, UK) -->
    <div id="global-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Global Access Service</label>
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="global-option" value="duns" class="w-4 h-4" checked>
            <div>
              <span class="font-medium">DUNS Number Registration</span>
              <p class="text-xs text-zinc-500">$50 USD - Official D&B registration, 3-5 days</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="global-option" value="us-wyoming" class="w-4 h-4">
            <div>
              <span class="font-medium">US LLC - Wyoming (Best for Non-Residents)</span>
              <p class="text-xs text-zinc-500">$720 USD - No state tax, strong privacy</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="global-option" value="us-delaware" class="w-4 h-4">
            <div>
              <span class="font-medium">US LLC - Delaware (For Startups)</span>
              <p class="text-xs text-zinc-500">$750 USD - Investor-friendly, VC preferred</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="global-option" value="us-newmexico" class="w-4 h-4">
            <div>
              <span class="font-medium">US LLC - New Mexico (Cheapest)</span>
              <p class="text-xs text-zinc-500">$650 USD - Lowest cost, no annual fees</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="global-option" value="uk" class="w-4 h-4">
            <div>
              <span class="font-medium">UK Company Registration (Ltd)</span>
              <p class="text-xs text-zinc-500">$500 USD - Companies House, £100 filing fee</p>
            </div>
          </label>
        </div>
      </div>
    </div>

    <!-- FOREIGN COMPANY REGISTRATION IN NIGERIA SECTION -->
    <div id="foreign-section" class="hidden space-y-5">
      <div>
        <label class="block text-sm font-bold text-black mb-2">Foreign Company Registration Package</label>
        <div class="space-y-2">
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="foreign-option" value="standard" class="w-4 h-4" checked>
            <div>
              <span class="font-medium">Standard Package</span>
              <p class="text-xs text-zinc-500">$350 USD - CAC registration, Business Permit, TIN</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="foreign-option" value="expat" class="w-4 h-4">
            <div>
              <span class="font-medium">Expatriate Support Package</span>
              <p class="text-xs text-zinc-500">$550 USD - Includes Expatriate Quota + CERPAC guidance</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="foreign-option" value="rep-office" class="w-4 h-4">
            <div>
              <span class="font-medium">Representative Office</span>
              <p class="text-xs text-zinc-500">$250 USD - Liaison office, no share capital</p>
            </div>
          </label>
          <label class="flex items-center gap-3 p-3 border border-zinc-200 rounded-xl cursor-pointer hover:border-black transition-all">
            <input type="radio" name="foreign-option" value="permit-only" class="w-4 h-4">
            <div>
              <span class="font-medium">Business Permit Only</span>
              <p class="text-xs text-zinc-500">$150 USD - For existing local structure</p>
            </div>
          </label>
        </div>
      </div>
    </div>


  </div>
</div>

<script is:inline>
  (function() {
    const selectedCategories = new Set(['registration']);
    let currentType='ltd', currentShareCapital=1000000, includeTaxPromax=false;
    const registrationPrices={'business-name':{base:35000,taxpromax:60000,govFee:30000,vobelsFee:5000},ltd:{base:45000,taxpromax:70000,perMillion:25000,govBase:35000,govPerMillion:25000},plc:{base:105000,perMillion:40000,govBase:68000,govPerMillion:25000},ngo:{base:150000,taxpromax:200000,govFee:135000}};
    const trademarkPrices={basic:{total:70000,govFee:45000,vobelsFee:25000},premium:{total:150000,govFee:45000,vobelsFee:105000}};
    const copyrightPrices={basic:{total:50000,govFee:35000,vobelsFee:15000},premium:{total:150000,govFee:35000,vobelsFee:115000}};
    const patentPrices={local:{total:250000,govFee:200000,vobelsFee:50000,currency:'NGN'},international:{total:2000,govFee:1500,vobelsFee:500,currency:'USD'}};
    const nafdacPrices={micro:{total:95000,govFee:75000,vobelsFee:20000},small:{total:150000,govFee:120000,vobelsFee:30000},large:{total:250000,govFee:200000,vobelsFee:50000},drugs:{total:300000,govFee:250000,vobelsFee:50000},'cosmetics-small':{total:120000,govFee:95000,vobelsFee:25000},'cosmetics-large':{total:200000,govFee:160000,vobelsFee:40000}};
    const globalPrices={duns:{total:50,govFee:35,vobelsFee:15,currency:'USD'},'us-wyoming':{total:720,govFee:120,vobelsFee:600,currency:'USD'},'us-delaware':{total:750,govFee:110,vobelsFee:640,currency:'USD'},'us-newmexico':{total:650,govFee:50,vobelsFee:600,currency:'USD'},uk:{total:500,govFee:130,vobelsFee:370,currency:'USD'}};
    const foreignPrices={standard:{total:350,govFee:100,vobelsFee:250,currency:'USD'},expat:{total:550,govFee:150,vobelsFee:400,currency:'USD'},'rep-office':{total:250,govFee:80,vobelsFee:170,currency:'USD'},'permit-only':{total:150,govFee:50,vobelsFee:100,currency:'USD'}};
    const names={registration:'Business registration',trademark:'Trademark',copyright:'Copyright',patent:'Patent',nafdac:'NAFDAC',global:'Global access',foreign:'Foreign company registration'};
    const sectionIds={registration:'registration-section',trademark:'trademark-section',copyright:'copyright-section',patent:'patent-section',nafdac:'nafdac-section',global:'global-section',foreign:'foreign-section'};
    const money=(n,c)=>(c==='USD'?'$':'₦')+Number(n||0).toLocaleString();
    function estimate(category){let total=0,govFee=0,vobelsFee=0,currency='NGN',label='';
      if(category==='registration'){const p=registrationPrices[currentType];if(currentType==='ltd'||currentType==='plc'){const extra=Math.max(0,Math.floor((currentShareCapital-1000000)/1000000));total=(currentType==='ltd'&&includeTaxPromax?p.taxpromax:p.base)+extra*p.perMillion;govFee=p.govBase+extra*p.govPerMillion;}else{total=includeTaxPromax?p.taxpromax:p.base;govFee=p.govFee;}vobelsFee=total-govFee;label=({'ltd':'Private Limited (LTD)','business-name':'Business Name',ngo:'NGO / Foundation',plc:'Public Limited (PLC)'})[currentType];}
      if(category==='trademark'){const o=document.querySelector('input[name="trademark-option"]:checked')?.value||'basic',p=trademarkPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;label=o==='basic'?'Trademark Registration':'Trademark Registration + Certificate';}
      if(category==='copyright'){const o=document.querySelector('input[name="copyright-option"]:checked')?.value||'basic',p=copyrightPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;label=o==='basic'?'Copyright Protection':'Copyright Protection (Premium)';}
      if(category==='patent'){const o=document.querySelector('input[name="patent-option"]:checked')?.value||'local',p=patentPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;currency=p.currency;label=o==='local'?'Local Patent Registration':'International Patent (PCT)';}
      if(category==='nafdac'){const o=document.getElementById('nafdac-category')?.value||'micro',p=nafdacPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;label=({'micro':'Micro-scale food',small:'Small-scale food',large:'Large-scale food',drugs:'Drugs & pharmaceuticals','cosmetics-small':'Cosmetics small scale','cosmetics-large':'Cosmetics large scale'})[o];}
      if(category==='global'){const o=document.querySelector('input[name="global-option"]:checked')?.value||'duns',p=globalPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;currency=p.currency;label=({duns:'DUNS number registration','us-wyoming':'US LLC — Wyoming','us-delaware':'US LLC — Delaware','us-newmexico':'US LLC — New Mexico',uk:'UK company registration'})[o];}
      if(category==='foreign'){const o=document.querySelector('input[name="foreign-option"]:checked')?.value||'standard',p=foreignPrices[o];total=p.total;govFee=p.govFee;vobelsFee=p.vobelsFee;currency=p.currency;label=({standard:'Standard package',expat:'Expatriate support package','rep-office':'Representative office','permit-only':'Business permit only'})[o];}
      return {category,name:names[category],label,total,govFee,vobelsFee,currency};}
    function render(){const chosen=Array.from(selectedCategories).map(estimate),items=document.getElementById('estimate-items'),totals=document.getElementById('estimate-totals');
      if(!chosen.length){items.innerHTML='<p class="vobels-calculator__empty">Choose a service category to see its estimate here.</p>';totals.innerHTML='';document.getElementById('price-note').textContent='Select the services you need. Your estimate will update as you configure them.';return;}
      items.innerHTML=chosen.map((x,i)=>'<article class="vobels-calculator__estimate-item"><div class="vobels-calculator__estimate-item-head"><div class="vobels-calculator__estimate-item-title"><small>'+String(i+1).padStart(2,'0')+' / '+x.name+'</small><strong>'+x.label+'</strong></div><b>'+money(x.total,x.currency)+'</b></div><div class="vobels-calculator__fee-breakdown"><div><span>Official fees</span><strong>'+money(x.govFee,x.currency)+'</strong></div><div><span>Vobels service fee</span><strong>'+money(x.vobelsFee,x.currency)+'</strong></div></div></article>').join('');
      totals.innerHTML=['NGN','USD'].filter(c=>chosen.some(x=>x.currency===c)).map(c=>{const group=chosen.filter(x=>x.currency===c),sum=k=>group.reduce((n,x)=>n+x[k],0);return '<section class="vobels-calculator__currency-total"><div class="vobels-calculator__currency-heading"><span>'+(c==='NGN'?'NIGERIAN NAIRA':'US DOLLAR')+'</span><small>'+group.length+' service'+(group.length===1?'':'s')+'</small></div><div><span>Official fees subtotal</span><b>'+money(sum('govFee'),c)+'</b></div><div><span>Vobels fees subtotal</span><b>'+money(sum('vobelsFee'),c)+'</b></div><div class="vobels-calculator__grand-total"><strong>Combined '+(c==='USD'?'USD':'NGN')+' estimate</strong><strong>'+money(sum('total'),c)+'</strong></div></section>';}).join('');
      document.getElementById('price-note').textContent=chosen.length+' selected service'+(chosen.length===1?'':'s')+'. Fees are itemised by service and totals are separated by currency.';}
    function update(){document.querySelectorAll('.cat-btn').forEach(btn=>{const on=selectedCategories.has(btn.dataset.category);btn.classList.toggle('bg-black',on);btn.classList.toggle('text-white',on);btn.classList.toggle('border-black',on);btn.classList.toggle('border-zinc-200',!on);btn.setAttribute('aria-pressed',String(on));const state=btn.querySelector('.cat-btn__state');if(state)state.classList.toggle('is-selected',on);});
      Object.keys(sectionIds).forEach(k=>document.getElementById(sectionIds[k])?.classList.toggle('hidden',!selectedCategories.has(k)));
      document.getElementById('share-capital-group').classList.toggle('hidden',!['ltd','plc'].includes(currentType));
      document.getElementById('taxpromax-group').classList.toggle('hidden',currentType==='plc');
      const labels=Array.from(selectedCategories).map(k=>names[k]);document.getElementById('category-description').textContent=labels.length?labels.length+' categor'+(labels.length===1?'y':'ies')+' selected. Configure the options for each service below.':'No categories selected. Choose the categories you need above.';render();}
    document.querySelectorAll('.cat-btn').forEach(btn=>btn.addEventListener('click',()=>{const c=btn.dataset.category;if(selectedCategories.has(c))selectedCategories.delete(c);else selectedCategories.add(c);update();}));
    document.querySelectorAll('.type-btn').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.type-btn').forEach(b=>{b.classList.remove('bg-black','text-white','border-black');b.classList.add('border-zinc-200');});btn.classList.add('bg-black','text-white','border-black');currentType=btn.dataset.type;document.getElementById('share-capital-group').classList.toggle('hidden',!['ltd','plc'].includes(currentType));document.getElementById('taxpromax-group').classList.toggle('hidden',currentType==='plc');if(currentType==='plc'){includeTaxPromax=false;document.getElementById('include-taxpromax').checked=false;}update();}));
    document.getElementById('calculate-btn')?.addEventListener('click',()=>{let n=parseInt(document.getElementById('share-capital').value,10);if(!Number.isFinite(n)||n<1000000)n=1000000;currentShareCapital=n;document.getElementById('share-capital').value=n;update();});
    document.getElementById('include-taxpromax')?.addEventListener('change',e=>{includeTaxPromax=e.target.checked;update();});
    document.getElementById('nafdac-category')?.addEventListener('change',update);
    ['trademark-option','copyright-option','patent-option','global-option','foreign-option'].forEach(n=>document.querySelectorAll('input[name="'+n+'"]').forEach(el=>el.addEventListener('change',update)));
