---
import heroImage from "@/assets/hero.png";
import Link from "@/components/ui/link.astro";
---

<section class="vobels-hero" aria-labelledby="vobels-hero-title">
  <div class="vobels-hero__copy">
    <p class="vobels-eyebrow"><span></span> Business enablement · Strategic growth · Venture partnership</p>
    <h1 id="vobels-hero-title">Build with intention.<br /><em>Grow with structure.</em></h1>
    <p class="vobels-hero__lead">
      We help businesses move from an idea to a well-run, growth-ready organisation — bringing together the strategy, structure, systems and support to make progress sustainable.
    </p>
    <div class="vobels-hero__actions">
      <Link href="/services" class="vobels-button vobels-button--dark">Explore what we do <span aria-hidden="true">→</span></Link>
      <Link href="/contact" class="vobels-button vobels-button--outline">Start a conversation</Link>
    </div>
    <div class="vobels-hero__note">
      <span class="vobels-hero__note-line"></span>
      <span>For founders, growing businesses and established organisations.</span>
    </div>
  </div>

  <div class="vobels-hero__visual">
    <div class="vobels-hero__image">
      <img
        src={heroImage.src}
        alt="A visual representation of business building and growth"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="vobels-hero__image-caption">
      <span>01 / THE BIG PICTURE</span>
      <span>From foundation to maturity</span>
    </div>
    <div class="vobels-hero__stamp" aria-hidden="true">
      <span>BUILD</span><span>·</span><span>MANAGE</span><span>·</span><span>SCALE</span>
    </div>
  </div>
</section>