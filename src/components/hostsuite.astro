---
import { Icon } from "astro-icon/components";
---

<section id="hostsuite" class="vobels-product" aria-labelledby="hostsuite-heading">
  <div class="vobels-product__visual">
    <div class="vobels-product__visual-top">
      <span>VOBELS / VENTURE 001</span>
      <span>PRODUCT SPOTLIGHT</span>
    </div>
    <div class="vobels-product__visual-mark" aria-hidden="true">
      <span>H</span>
      <i></i>
    </div>
    <div class="vobels-product__visual-bottom">
      <span>HOSTSUITE</span>
      <span>WEBSITE CARE & MANAGEMENT</span>
    </div>
  </div>
  <div class="vobels-product__copy">
    <p class="vobels-eyebrow vobels-eyebrow--light"><span></span> A product from Vobels</p>
    <h2 id="hostsuite-heading">Your website needs care long after <em>it goes live.</em></h2>
    <p>HostSuite helps businesses manage, maintain and get support for their websites and digital assets — even when another developer built them.</p>
    <a href="https://hostsuite.vobels.com" class="vobels-button vobels-button--light">
      Explore HostSuite <Icon name="bx:bx-right-arrow-alt" class="h-5 w-5" />
    </a>
    <span class="vobels-product__footnote">Website management, made easier.</span>
  </div>
</section>