---
import { Icon } from "astro-icon/components";
---

<section id="hostsuite" class="mt-16 md:mt-24 mb-8">
  <div class="relative overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-950 px-6 py-9 md:px-10 md:py-12 text-white">
    <div class="absolute left-0 top-0 h-1 w-24 bg-violet-500"></div>
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div class="max-w-2xl">
        <p class="mb-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-violet-300">
          <span class="h-2 w-2 rounded-full bg-violet-400"></span>
          A product from Vobels
        </p>
        <h2 class="text-3xl font-bold leading-tight tracking-tight md:text-4xl">
          Your website needs care long after it goes live.
        </h2>
        <p class="mt-4 max-w-xl leading-relaxed text-zinc-300">
          HostSuite helps businesses manage, maintain and get support for their websites and digital assets—even when another developer built them.
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 lg:items-end">
        <a
          href="https://hostsuite.vobels.com"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-white px-5 py-3 font-semibold text-zinc-950 transition hover:bg-violet-100 focus:outline-none focus:ring-2 focus:ring-violet-400 focus:ring-offset-2 focus:ring-offset-zinc-950"
        >
          Explore HostSuite
          <Icon name="bx:bx-right-arrow-alt" class="h-5 w-5" />
        </a>
        <span class="text-sm text-zinc-400">Website management, made easier.</span>
      </div>
    </div>
  </div>
</section>
